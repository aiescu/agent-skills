{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geekbye.com/cv-templates/candidate.schema.json",
  "title": "GeekBye CV pack candidate v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": ["company", "title", "startDate", "endDate", "description"]
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school": {
            "type": "string"
          },
          "degree": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "graduationDate": {
            "type": "string",
            "description": "Supplied education date only; does not establish enrolled, completed, expected or current status. Preserve unknown as an empty string."
          }
        },
        "required": ["school", "degree", "field", "graduationDate"]
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "technologies": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": ["name", "startDate", "endDate", "description", "technologies", "url"]
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "authors": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": ["title", "authors", "venue", "date", "url"]
      }
    }
  },
  "required": [
    "name",
    "title",
    "email",
    "phone",
    "location",
    "objective",
    "links",
    "skills",
    "experience",
    "education",
    "projects",
    "publications"
  ]
}
